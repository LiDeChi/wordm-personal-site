# Optional live API endpoint from center-control
VITE_CENTER_CONTROL_API=

# Supabase auth (shared for wordm.us + *.wordm.us, same project as latti-wordm)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_ADMIN_EMAILS=
VITE_AUTH_TEST_EMAILS=

# Creem checkout product IDs (reuse latti billing backend)
VITE_UNLOCK_PRODUCT_SINGLE=
VITE_UNLOCK_PRODUCT_ALL_ACCESS=
# Legacy fallbacks, kept for compatibility with older deployments:
VITE_UNLOCK_PRODUCT_ALL_CURRENT=
VITE_UNLOCK_PRODUCT_ALL_CURRENT_PLUS_YEAR=
VITE_SELFHOST_INSTALL_URL=https://github.com/LiDeChi/center-control#付费用户一键安装deploy-ticket
VITE_SELFHOST_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/LiDeChi/center-control/main/scripts/install-center-control.sh

# Fount Partner Program application fallback
NEXT_PUBLIC_CREEM_AFFILIATE_APPLY_URL=
NEXT_PUBLIC_PARTNER_CONTACT_EMAIL=

# Local sync source (used by `npm run sync:projects`)
CENTER_CONTROL_EXPORT=/Users/lidechi/Documents/Github/center-control/data/exports/projects.json

# Cloudflare Pages project name (used by bind/deploy scripts)
CF_PAGES_PROJECT=wordm-personal-home

# Server-side Kimi chat proxy for /api/chat (Cloudflare Pages Functions)
# Keep the API key out of VITE_* variables so it is never bundled into the browser.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.7-code
KIMI_API_BASE_URL=https://api.moonshot.ai/v1
